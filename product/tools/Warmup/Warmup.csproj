<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MdPreviewWarmup</AssemblyName>
    <RootNamespace>MdPreview.Warmup</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\MdPreview\ComInterop.cs" Link="ComInterop.cs" />
    <None Include="warmup.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
